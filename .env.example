# Optional. Without an API key the app uses deterministic analysis rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL is required for durable drafts and historical PDFs on Render.
DATABASE_URL=

# Long random values used by /review and the scheduled endpoint.
ADMIN_TOKEN=
CRON_SECRET=

# Optional X login cookie. Never commit a real value.
X_AUTH_TOKEN=
ENABLE_BROWSER_COLLECTORS=true
